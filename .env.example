# Copy to .env and fill in. Loaded by both backend and frontend.

# --- Backend -----------------------------------------------------------------

# SQLite connection string. Native dev default; deploy overrides this to /data/app.db.
DATABASE_URL=sqlite:///./data/app.db

# Where a searchable copy of a scan waits between the poller producing it and approve filing
# it. Native dev default; deploy overrides this to /data/ocr, on the same volume as the
# database — a copy that vanished on restart would silently file the original instead.
OCR_CACHE_DIR=./data/ocr

# Fernet key used to encrypt the AI API key at rest. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this invalidates the stored AI API key — it must be re-entered in Settings.
SECRET_KEY=

# Nextcloud (or any WebDAV server). Use an app password, not the account password.
WEBDAV_BASE_URL=https://example.com/remote.php/dav/files/USERNAME
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
WEBDAV_WATCH_FOLDER=/Scans/Inbox

# --- Auth --------------------------------------------------------------------

# The public URL the browser reaches this app on. Used to build the OIDC redirect URI and to
# decide whether the session cookie may be marked Secure, so it must be the public address,
# not the container's. Native dev: the Vite origin.
APP_BASE_URL=http://localhost:5173

# The first account to register always wins the instance and becomes its admin. This governs
# everyone after them; leave false unless you want anyone who finds the URL to sign up.
ALLOW_REGISTRATION=false

# How long a signed-in browser stays signed in.
SESSION_LIFETIME_DAYS=30

# Single sign-on, one provider, confidential client. Leave OIDC_ISSUER empty to disable it
# (the sign-in screen then offers email/password only). Tested against Authentik: the issuer
# is the provider's "OpenID Configuration Issuer", minus the trailing slash if any.
#   OIDC_ISSUER=https://auth.example.com/application/o/document-router/
# Redirect URI to register with the provider: APP_BASE_URL + /api/v1/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=SSO
OIDC_SCOPES=openid email profile

# How often the poller scans the watch folder, in seconds.
POLL_INTERVAL_SECONDS=60

# Comma-separated list of origins allowed to call the API in dev.
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO

# --- Frontend ------------------------------------------------------------------

# Only needed if the frontend is served from a different origin than the API.
# Native dev proxies /api through Vite, so this can stay unset.
VITE_API_BASE_URL=
