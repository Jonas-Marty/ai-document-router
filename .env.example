# Copy to .env and fill in. Loaded by both backend and frontend.

# --- Backend -----------------------------------------------------------------

# SQLite connection string. Native dev default; deploy overrides this to /data/app.db.
DATABASE_URL=sqlite:///./data/app.db

# Fernet key used to encrypt the AI API key at rest. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this invalidates the stored AI API key — it must be re-entered in Settings.
SECRET_KEY=

# Nextcloud (or any WebDAV server). Use an app password, not the account password.
WEBDAV_BASE_URL=https://example.com/remote.php/dav/files/USERNAME
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
WEBDAV_WATCH_FOLDER=/Scans/Inbox

# How often the poller scans the watch folder, in seconds.
POLL_INTERVAL_SECONDS=60

# Comma-separated list of origins allowed to call the API in dev.
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO

# --- Frontend ------------------------------------------------------------------

# Only needed if the frontend is served from a different origin than the API.
# Native dev proxies /api through Vite, so this can stay unset.
VITE_API_BASE_URL=
